
{
  "schemaVersion": 1,
  "id": "nova-client",
  "version": "${version}",
  "name": "Nova Nebula v3",
  "description": "Nova Nebula v3 Minecraft Fabric client with ESP, Fullbright, ClickGUI, HUD, and customizable modules.",
  "authors": [
    "Nova Client"
  ],
  "license": "CC0-1.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "nova.client.client.NovaClient"
    ]
  },
  "mixins": [
    "nova-client.mixins.json",
    {
      "config": "nova-client.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
